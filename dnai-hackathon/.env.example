# Coston2 testnet — faucet-funded keys ONLY. Never a key controlling real value.
RPC_URL=https://coston2-api.flare.network/ext/C/rpc
DEPLOYER_KEY=your_faucet_funded_coston2_key
PLATFORM_ROYALTY_BPS=1000

# Optional: a SECOND faucet-funded key to play "licensee" in the mock smoke (step 3).
# Needed because one account can't request access to its own token.
SMOKE_KEY=

# Optional: set to 1 to also deploy the REAL FtsoV2Adapter, pull a live price via
# refresh(), and switch the contract onto it (step 4).
USE_REAL_FTSO=
